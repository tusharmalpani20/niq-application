{
  "name": "@niq/application-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --filter @niq/application-web build && bun src/prepare-report-print.ts && bun build src/index.ts --outdir dist --target bun --sourcemap=external --external sharp --external playwright-core",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:backfill-final-results": "bun src/backfill-assessment-final-results.ts",
    "dev": "bun run --filter @niq/application-web build && bun src/prepare-report-print.ts && bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "bun run --filter @niq/application-web build && bun src/prepare-report-print.ts && bun test"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.2",
    "@niq/application-config": "workspace:*",
    "@niq/application-contracts": "workspace:*",
    "@niq/application-domain": "workspace:*",
    "drizzle-orm": "0.44.5",
    "hono": "4.9.6",
    "playwright-core": "1.63.0",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.5",
    "web-push": "3.6.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@niq/application-web": "workspace:*",
    "@types/bun": "1.2.21",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.4",
    "typescript": "5.9.2"
  }
}
