{
  "name": "@niq/application-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "db:generate": "bun --filter @niq/application-api db:generate",
    "db:migrate": "bun --filter @niq/application-api db:migrate"
  },
  "devDependencies": {
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  }
}
