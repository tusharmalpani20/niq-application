# Copy outside the checkout to a private file with mode 600. Replace every placeholder.
# This file is consumed with docker compose --env-file, not copied into the image.
POSTGRES_PASSWORD=replace-with-independent-hex-secret
SESSION_SECRET=replace-with-independent-secret-at-least-32-characters
BOOTSTRAP_TOKEN=replace-with-independent-secret-at-least-32-characters
PATIENT_DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key
SCORING_CREDENTIAL_ENCRYPTION_KEY=replace-with-independent-base64-32-byte-key
PATIENT_DATA_KEY_VERSION=staging-v1
SCORING_CREDENTIAL_KEY_VERSION=staging-v1
WEB_ORIGIN=https://replace-with-your-staging-host.example
APP_REGION=india
DEPLOYMENT_MODE=client-cloud
# Development OTP delivery is explicit until the production delivery adapter exists.
DEV_OTP_DELIVERY=true
DEV_FIXED_OTP=false
FACE_SCAN_ENABLED=false
