# NIQ MAIN APPLICATION — ENVIRONMENT REFERENCE
#
# Copy this file to `.env` for local development. Never commit `.env`.
# Values shown below are development examples, not production credentials.
# Generate every secret independently, for example: openssl rand -hex 32

# Runtime environment.
# Values: development | test | production
# Default: development
NODE_ENV=development

# Region whose deployment and data-residency policy applies.
# Values currently supported: india | us | eu
# Default: india
APP_REGION=india

# Where this application installation runs:
# - niq-hosted: infrastructure and operations are managed by NIQ.
# - client-cloud: NIQ software runs in a cloud account controlled by the client.
# - on-prem: NIQ software runs in the client's own data centre/network.
# This changes deployment/operations policy; it does not change tenant ownership.
# Values: niq-hosted | client-cloud | on-prem
# Default: niq-hosted
DEPLOYMENT_MODE=niq-hosted

# Interface on which the API listens.
# Default: 0.0.0.0 (all container/host interfaces)
# For local-only access without containers, 127.0.0.1 is more restrictive.
API_HOST=0.0.0.0

# API TCP port.
# Values: integer from 1 to 65535
# Default: 3000
API_PORT=3000

# Exact public origin of the browser application. Do not add a trailing slash.
# Used by browser security controls such as CORS.
# Default: http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# PostgreSQL connection used only by the main application.
# Required; there is no default. Use a separate database from the scoring service.
# Replace the example password and URL-encode special characters in credentials.
DATABASE_URL=postgres://niq:replace-database-password@localhost:5432/niq_application

# Require PostgreSQL TLS.
# Values: true | false
# Default: false
# Use true in production unless TLS is terminated by a trusted private connection.
DATABASE_SSL=false

# Base URL of the independently deployed scoring API.
# Required to initialize a new assessment against an approved final questionnaire.
# Existing bound drafts can be edited while scoring is unavailable.
# Local scoring development example: http://localhost:4100
SCORING_API_URL=http://localhost:4100

# Maximum time in milliseconds to wait for a scoring API response.
# Values: positive integer up to 60000
# Default: 10000
SCORING_TIMEOUT_MS=10000

# New face-scan capture is disabled until vendor contract and staging validation finish.
# This server-only gate does not disable retrieval/reconciliation of existing scans.
FACE_SCAN_ENABLED=false

# Background recovery interval; API process runs the bounded reconciliation loop.
# Values: integer from 5000 to 300000 milliseconds. Default: 30000.
FACE_SCAN_RECONCILE_INTERVAL_MS=30000

# Private report files. Set an absolute directory outside the repository/public web root.
# Leave blank to disable uploads. Back up this directory together with PostgreSQL.
REPORT_UPLOAD_ROOT=
REPORT_MAX_FILE_BYTES=10485760
REPORT_MAX_FILES_PER_GROUP=10
REPORT_MAX_GROUPS=20
REPORT_MAX_ASSESSMENT_BYTES=104857600

# Encrypts permanent scoring deployment credentials before PostgreSQL storage.
# Optional until scoring activation is used; required in production whenever
# SCORING_API_URL is configured. Must decode to exactly 32 bytes.
# Generate once per application installation: openssl rand -base64 32
# Never share this value with the scoring service or commit it to Git.
SCORING_CREDENTIAL_ENCRYPTION_KEY=

# Identifier recorded beside encrypted credentials to support future key rotation.
# Values: any non-empty label up to 64 characters
# Default: local-v1
SCORING_CREDENTIAL_KEY_VERSION=local-v1

# Encrypts patient identifiers and profile data before PostgreSQL storage.
# Required in production. Development derives a purpose-scoped key from
# SESSION_SECRET when this is blank. Generate with: openssl rand -base64 32
PATIENT_DATA_ENCRYPTION_KEY=

# Identifier stored with encrypted patient records for future key rotation.
PATIENT_DATA_KEY_VERSION=local-v1

# IMPORTANT — scoring identity is intentionally not configured here.
# SCORING_CLIENT_ID, SCORING_DEPLOYMENT_ID and SCORING_CLIENT_SECRET are not
# application environment variables. An NIQ operator creates the customer and
# deployment in the central scoring platform and issues a one-time activation
# token. The application must exchange it server-to-server, then store the
# returned deployment credential in the encrypted server-side credential store.
# A scoring credential is never returned to or stored by the browser.

# Authentication strategy:
# - disabled: authentication routes are unavailable (safe initial default).
# - local: invite-only email/password authentication with OTP for administrators.
# - oidc: reserved for a future enterprise identity-provider integration; not yet
#   implemented and must not be selected for a working deployment today.
# Values: disabled | local | oidc
# Default: disabled
AUTH_MODE=local

# Secret used to hash/sign security-sensitive session material.
# Required; minimum 32 characters; no usable default.
# Generate independently per deployment and do not reuse BOOTSTRAP_TOKEN.
SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

# HTTP session-cookie name.
# Values: letters, numbers, underscore and hyphen only
# Default: niq_session
SESSION_COOKIE_NAME=niq_session

# Session lifetime in hours.
# Values: integer from 1 to 168
# Default: 12
SESSION_TTL_HOURS=12

# Administrator OTP lifetime in minutes.
# Values: integer from 2 to 15
# Default: 10
MFA_OTP_TTL_MINUTES=10

# Maximum incorrect OTP submissions before that challenge is rejected.
# Values: integer from 3 to 10
# Default: 5
MFA_MAX_ATTEMPTS=5

# Minimum wait before another OTP can be requested, in seconds.
# Values: integer from 30 to 300
# Default: 30
MFA_RESEND_COOLDOWN_SECONDS=30

# Maximum OTP resends allowed for one sign-in challenge.
# Values: integer from 1 to 5
# Default: 3
MFA_MAX_RESENDS=3

# Maximum failed password attempts before temporary account lockout.
# Values: integer from 3 to 20
# Default: 5
# Unlimited attempts are deliberately unsupported for security/compliance.
AUTH_MAX_ATTEMPTS=5

# Lockout duration in minutes after AUTH_MAX_ATTEMPTS is reached.
# Values: integer from 1 to 1440
# Default: 15
# Zero/disabled lockout is deliberately unsupported.
AUTH_LOCKOUT_MINUTES=15

# Lifetime of a one-time user invitation in hours.
# Values: integer from 1 to 720
# Default: 72
INVITATION_TTL_HOURS=72

# One-time administrative secret for creating the first local administrator.
# Optional in development; required when NODE_ENV=production and AUTH_MODE=local.
# Minimum 32 characters; no default. Generate independently, use it only through
# the bootstrap endpoint, then remove it from the running production environment.
BOOTSTRAP_TOKEN=replace-with-an-independent-random-token-at-least-32-characters

# Development-only OTP delivery: true returns/logs the OTP so local sign-in can
# be tested before MSG91 is integrated. This is separate from NODE_ENV so a
# developer must opt in explicitly. Production configuration rejects true.
# Values: true | false
# Default: false
DEV_OTP_DELIVERY=true

# Minimum log severity:
# - debug: detailed diagnostics; local troubleshooting only.
# - info: normal lifecycle and request events; recommended default.
# - warn: unexpected/recoverable conditions plus errors.
# - error: failures only.
# Values: debug | info | warn | error
# Default: info
# Logs must never contain passwords, OTPs, tokens, secrets, or patient health data.
LOG_LEVEL=info
