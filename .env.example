# Non-secret deployment settings. Copy to .env and never commit the result.
NODE_ENV=development
APP_REGION=india
DEPLOYMENT_MODE=niq-hosted
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Development-only examples. Replace every credential outside local development.
DATABASE_URL=postgres://niq:change-me@localhost:5432/niq_application
DATABASE_SSL=false

# Outbound scoring is optional. Assessments remain saveable when it is unavailable.
SCORING_API_URL=https://scoring.example.invalid
SCORING_CLIENT_ID=replace-me
SCORING_DEPLOYMENT_ID=replace-me
SCORING_CLIENT_SECRET=replace-me
SCORING_TIMEOUT_MS=10000

# Authentication is intentionally disabled until an identity strategy is selected.
AUTH_MODE=disabled
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
